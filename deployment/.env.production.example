# Copy to .env.production. Never commit the copied file.
APP_NAME="Pacientu anketu sistēma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=lv
APP_FALLBACK_LOCALE=lv
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=patient_questionnaires
DB_USERNAME=patient_app
DB_PASSWORD=

# MariaDB container initialization values. Keep these aligned with DB_* above.
MARIADB_DATABASE=patient_questionnaires
MARIADB_USER=patient_app
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Only the private Docker backend subnet is trusted for forwarded headers.
TRUSTED_PROXIES=172.31.0.0/24

# Safe minimum: finalized-submission notifications are logged until SMTP is configured.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Pacientu anketu sistēma"
# MAIL_SCHEME=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# Keep empty for the default local-only installation. Configure once with
# deployment\CONFIGURE-PUBLIC-SERVER.bat when public HTTPS is ready.
CLOUDFLARE_TUNNEL_TOKEN=
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Used only by the frontend build if required by Vite.
VITE_APP_NAME="Pacientu anketu sistēma"
